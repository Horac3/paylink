# Database
DATABASE_URL=postgresql://paylink:paylink_password@localhost:5433/paylink

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<generate-48-random-bytes-base64>
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PAYER_SESSION_SECRET=<generate-48-random-bytes-base64>
PAYER_SESSION_EXPIRY=30d

# PawaPay — get a token from the PawaPay merchant dashboard (shown only once)
PAWAPAY_API_TOKEN=<pawapay-api-token>
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_CALLBACK_DEPOSIT=https://api.paylinks.never9to5ive.com/api/v1/callback/deposit
PAWAPAY_CALLBACK_PAYOUTS=https://api.paylinks.never9to5ive.com/api/v1/callback/payouts
PAWAPAY_CALLBACK_REFUND=https://api.paylinks.never9to5ive.com/api/v1/callback/refund
PAWAPAY_AIRTEL_MALAWI_PROVIDER=AIRTEL_MWI
PAWAPAY_TNM_MALAWI_PROVIDER=TNM_MWI

# TNM Mpamba
TNM_BASE_URL=https://[confirm-with-tnm]
TNM_WALLET=your-tnm-wallet-id
TNM_PASSWORD=your-tnm-password

# Airtel Money
AIRTEL_BASE_URL=https://openapiuat.airtel.mw
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_COUNTRY=MW
AIRTEL_CURRENCY=MWK
AIRTEL_DISBURSE_PIN=your-encrypted-disbursement-pin
AIRTEL_DISBURSE_PUBLIC_KEY=your-rsa-public-key-base64

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=<firebase-project-id>

# Email — Gmail requires an app password, not the account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-smtp-email>
SMTP_PASSWORD=<gmail-app-password>
EMAIL_FROM=PayLink <your-smtp-email>

# MSISDN encryption — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64-hex-characters-32-bytes>
ENCRYPTION_IV_LENGTH=16

# App
APP_URL=https://api.paylink.never9to5ive.com
WEB_URL=https://paylink.never9to5ive.com
DOCS_URL=http://localhost:5173
APP_PORT=3000
NODE_ENV=development


